/* =================================
   GIFT BOX
================================= */

.gift-area {
  margin: 65px auto 35px;
  cursor: pointer;
  position: relative;
  width: 180px;
  height: 175px;
  transition: transform .3s;
  animation: giftFloat 3s ease-in-out infinite;
}

.gift-area:hover {
  transform: scale(1.07);
}

@keyframes giftFloat {
  0%,100% { translate: 0 0; }
  50% { translate: 0 -8px; }
}

.gift-box {
  position: absolute;
  bottom: 0;
  width: 180px;
  height: 120px;
  background: #b99bdc;
  border-radius: 8px;
  box-shadow: 0 15px 25px #9b7bb830;
}

.gift-box::before {
  content: "";
  position: absolute;
  left: 70px;
  width: 38px;
  height: 100%;
  background: #f8efff;
}

.gift-lid {
  position: absolute;
  top: 43px;
  left: -10px;
  width: 200px;
  height: 33px;
  background: #9875bd;
  border-radius: 6px;
  z-index: 2;
  transition: .8s;
}

.gift-lid::before {
  content: "";
  position: absolute;
  left: 81px;
  width: 38px;
  height: 100%;
  background: #f8efff;
}

.bow {
  position: absolute;
  top: 5px;

  /* Căn chính giữa hộp quà */
  left: 50%;
  transform: translateX(-50%);

  width: 50px;
  height: 40px;
  z-index: 3;
}

.bow::before,
.bow::after {
  content: "";
  position: absolute;

  width: 27px;
  height: 28px;

  border: 7px solid #8063a5;
  border-radius: 50% 50% 0 50%;
}

.bow::before {
  left: 0;
  transform: rotate(35deg);
}

.bow::after {
  right: 0;
  transform: scaleX(-1) rotate(35deg);
}

.gift-open .gift-lid {
  transform: translateY(-100px) rotate(-15deg);
  opacity: 0;
}

.open-text {
  color: var(--purple-dark);
  font-weight: 700;
  font-size: 14px;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  50% { opacity: .5; }
}

/* =================================
   TREE SCREEN
================================= */

#treeScreen {
  padding-top: 35px;
  padding-bottom: 60px;
}

.tree-heading {
  margin-bottom: 8px;
}

.tree-heading h1 {
  font-size: clamp(32px, 5vw, 50px);
}

.tree-heading p {
  font-size: 13px;
  color: #998a9f;
  margin-top: 10px;
  line-height: 1.8;
}

/* =================================
   TREE STRUCTURE
================================= */

.tree-container {
  position: relative;
  width: min(95vw, 560px);
  height: 650px;
  margin: 15px auto 0;
}

.tree {
  position: absolute;
  left: 50%;
  top: 45px;
  transform: translateX(-50%);
  width: 0;
  height: 0;

  border-left: 220px solid transparent;
  border-right: 220px solid transparent;
  border-bottom: 510px solid #8eae8c;

  filter: drop-shadow(0 8px 5px #67876b22);
}

.tree::before {
  content: "";
  position: absolute;
  top: 125px;
  left: -165px;

  border-left: 165px solid transparent;
  border-right: 165px solid transparent;
  border-bottom: 370px solid #719977;
}

.tree::after {
  content: "";
  position: absolute;
  top: 245px;
  left: -105px;

  border-left: 105px solid transparent;
  border-right: 105px solid transparent;
  border-bottom: 250px solid #638c70;
}

.trunk {
  position: absolute;
  top: 545px;
  left: 50%;
  transform: translateX(-50%);
  width: 48px;
  height: 65px;
  background: #a97c62;
  border-radius: 5px;
  z-index: 1;
}

.star {
  position: absolute;
  z-index: 3;
  top: 15px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 45px;
  color: #e9c77d;
  filter: drop-shadow(0 2px 8px #e9b85f80);
  animation: twinkle 2s infinite;
}

@keyframes twinkle {
  50% {
    transform: translateX(-50%) scale(1.2);
  }
}

/* =================================
   42 CAMERA ORNAMENTS
================================= */

.wishes-layer {
  position: absolute;
  inset: 0;
  z-index: 5;
}

/* Camera placement uses CENTER alignment */

.ornament {
  position: absolute;
  width: 34px;
  height: 55px;
  cursor: pointer;

  transform: translateX(-50%);
  transform-origin: top center;

  animation: swing 3s ease-in-out infinite;
  transition: transform .3s;
  z-index: 5;
}

.ornament:hover {
  transform: translateX(-50%) scale(1.2);
  z-index: 10;
}

@keyframes swing {
  0%,100% { rotate: -4deg; }
  50% { rotate: 4deg; }
}

/* Hook at the tree canopy */

.hook {
  position: absolute;
  top: -27px;
  left: 50%;
  transform: translateX(-50%);

  width: 8px;
  height: 8px;
  border-radius: 50%;

  background: #e9c77d;
  border: 1px solid #fff4d9;
  z-index: 2;
}

/* String connected to the camera */

.string {
  position: absolute;
  left: 50%;
  top: -23px;
  transform: translateX(-50%);

  width: 2px;
  height: 25px;

  background: #e5c9a7;
  border-radius: 2px;
  z-index: 1;
}

/* Camera body */

.camera {
  position: relative;
  width: 34px;
  height: 27px;
  margin-top: 0;

  border-radius: 7px;
  background: #cdb8e8;
  border: 2px solid #fff;

  box-shadow: 0 3px 9px #00000020;

  display: flex;
  justify-content: center;
  align-items: center;

  transition: .25s;
}

/* Camera top */

.camera::before {
  content: "";
  position: absolute;

  width: 12px;
  height: 5px;

  background: inherit;
  border: 1px solid #fff;
  border-bottom: none;

  border-radius: 4px 4px 0 0;

  top: -6px;
  left: 8px;
}

/* Camera lens */

.camera-lens {
  width: 13px;
  height: 13px;
  border-radius: 50%;

  background: #fff;
  border: 3px solid #8063a5;

  box-shadow: inset 0 0 0 2px #d7c4ed;
}

/* Camera flash */

.camera-flash {
  position: absolute;
  width: 4px;
  height: 4px;

  background: #fff6d9;
  border-radius: 50%;

  right: 4px;
  top: 5px;
}

/* Alternating camera colors */

.ornament:nth-child(3n+1) .camera {
  background: #cdb8e8;
}

.ornament:nth-child(3n+2) .camera {
  background: #e6d9f5;
}

.ornament:nth-child(3n) .camera {
  background: #d8e2d0;
}

.ornament:hover .camera {
  box-shadow: 0 0 15px #b99bdc;
}

.instruction {
  color: #a58caa;
  font-size: 13px;
  margin-top: 0;
}

/* =================================
