// ========================================
// 3. TẠO 42 MÁY ẢNH VÀ DÂY TREO
// ========================================

const layer = document.getElementById("wishesLayer");

wishes.forEach((wish, index) => {

  const ornament = document.createElement("div");

  ornament.className = "ornament";

  // Căn theo tâm máy ảnh
  ornament.style.left = positions[index][0] + "%";
  ornament.style.top = positions[index][1] + "%";

  ornament.style.animationDelay =
    (index * 0.08) + "s";

  ornament.innerHTML = `
    <div class="hook"></div>
    <div class="string"></div>

    <div class="camera">
      <div class="camera-lens"></div>
      <div class="camera-flash"></div>
    </div>
  `;

  ornament.setAttribute(
    "aria-label",
    "Lời chúc số " + (index + 1)
  );

  ornament.onclick = () => showLetter(index);

  layer.appendChild(ornament);

});


// ========================================
// 4. HIỆU ỨNG MỞ HỘP QUÀ
// ========================================

function openGift() {

  const gift = document.getElementById("gift");

  gift.classList.add("gift-open");

  setTimeout(() => {

    document.getElementById("giftScreen")
      .classList.add("hidden");

    document.getElementById("treeScreen")
      .classList.remove("hidden");

    window.scrollTo(0, 0);

  }, 650);

}


// ========================================
// 5. HIỂN THỊ LỜI CHÚC
// ========================================

function showLetter(index) {

  const wish = wishes[index];

  document.getElementById("letterName").innerText =
    "Dear chị Phương Anh,";

  document.getElementById("letterContent").innerText =
    wish.message;

  document.getElementById("letterSender").innerText =
    wish.name ? "With love, " + wish.name : "";

  document.getElementById("modal")
    .classList.remove("hidden");

}


// ========================================
// 6. ĐÓNG THIỆP
// ========================================

function closeLetter() {

  document.getElementById("modal")
    .classList.add("hidden");

}

function closeOutside(event) {

  if (event.target.id === "modal") {
    closeLetter();
  }

}


// ========================================
// 7. NHẤN ESC ĐỂ ĐÓNG THIỆP
// ========================================

document.addEventListener("keydown", (event) => {

  if (event.key === "Escape") {
    closeLetter();
  }

});

</script>

